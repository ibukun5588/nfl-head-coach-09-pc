# Writes build_id.h with the git commit of the source tree (re-run every build;
# the file is only rewritten when the id changes so nothing recompiles needlessly).
execute_process(COMMAND git -C "${SRC}" rev-parse --short HEAD OUTPUT_VARIABLE ID OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no OUTPUT_VARIABLE DIRTY ERROR_QUIET)
if(NOT ID)
  set(ID "unknown")
endif()
if(DIRTY)
  set(ID "${ID}+")
endif()
set(CONTENT "#pragma once\n#define HC09_BUILD_ID \"${ID}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" OLD)
else()
  set(OLD "")
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE "${OUT}" "${CONTENT}")
endif()
